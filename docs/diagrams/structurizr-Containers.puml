person "==CI Platform Operator\n<size:16>[Person]</size>\n\nConfigures cilicon.yml on the host Mac and watches the app window" <<Element-RWxlbWVudCxQZXJzb24=>> as CIPlatformOperator
rectangle "==OCI Registry\n<size:16>[Software System]</size>\n\nHosts tart-format macOS images (e.g. ghcr.io/cirruslabs)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as OCIRegistry
rectangle "==GitHub API\n<size:16>[Software System]</size>\n\nGitHub App auth and Actions runner registration tokens" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as GitHubAPI
rectangle "==GitLab Instance\n<size:16>[Software System]</size>\n\nRegisters and dispatches jobs to gitlab-runner" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as GitLabInstance
rectangle "==Buildkite\n<size:16>[Software System]</size>\n\nAgent registration and job dispatch" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as Buildkite
rectangle "==Runner Binary Downloads\n<size:16>[Software System]</size>\n\nGitHub runner release assets, GitLab S3 bucket, Buildkite install script" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as RunnerBinaryDownloads
rectangle "==macOS Host Services\n<size:16>[Software System]</size>\n\nDHCP lease database and Apple Events restart" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as macOSHostServices

rectangle "Cilicon\n<size:16>[Software System]</size>" <<Boundary-Q2lsaWNvbg==>> {
  folder "==VM Clone\n<size:16>[Container: APFS directory]</size>\n\nPer-run copy of the master bundle, deleted and recreated every cycle" <<Element-RWxlbWVudCxDb250YWluZXIsRmlsZQ==>> as Cilicon.VMClone
  rectangle "==Ephemeral macOS Guest VM\n<size:16>[Container: Virtualization.framework, macOS arm64]</size>\n\nRuns the CI agent; discarded after the job" <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cilicon.EphemeralmacOSGuestVM
  rectangle "==Cilicon App (SwiftUI)\n<size:16>[Container: Swift 6, SwiftUI, AppKit]</size>\n\nLoads cilicon.yml, renders VM framebuffer and the SSH log stream" <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cilicon.CiliconAppSwiftUI
  rectangle "==VM Manager\n<size:16>[Container: Swift, Virtualization.framework]</size>\n\nOwns the run cycle: pull image, clone bundle, boot VM, connect SSH, provision, tear down, repeat" <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cilicon.VMManager
  rectangle "==OCI Client & Layer Downloaders\n<size:16>[Container: Swift, URLSession, Compression]</size>\n\nPulls tart-format manifests and lz4 disk layers from an OCI registry" <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cilicon.OCIClientLayerDownloaders
  rectangle "==Provisioners\n<size:16>[Container: Swift]</size>\n\nPer-CI-backend command builders executed over SSH inside the guest" <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cilicon.Provisioners
  rectangle "==SSH Client\n<size:16>[Container: Citadel / swift-nio-ssh]</size>\n\nPassword-authenticated SSH session used for preRun, provisioning, liveness probes and postRun" <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cilicon.SSHClient
  folder "==cilicon.yml\n<size:16>[Container: YAML file in host home directory]</size>\n\nDeclarative host configuration: source, provisioner, hardware, mounts, SSH credentials" <<Element-RWxlbWVudCxDb250YWluZXIsRmlsZQ==>> as Cilicon.ciliconyml
  folder "==Image Cache\n<size:16>[Container: APFS directory]</size>\n\nDownloaded master bundles (disk.img, nvram.bin, config.json) under $HOME/.tart/cache/OCIs" <<Element-RWxlbWVudCxDb250YWluZXIsRmlsZQ==>> as Cilicon.ImageCache
}

CIPlatformOperator --> Cilicon.ciliconyml <<Relationship-UmVsYXRpb25zaGlw>> : "Writes configuration"
CIPlatformOperator --> Cilicon.CiliconAppSwiftUI <<Relationship-UmVsYXRpb25zaGlw>> : "Launches and observes"
Cilicon.CiliconAppSwiftUI --> Cilicon.ciliconyml <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and decodes at startup\n<size:16>[YAML]</size>"
Cilicon.CiliconAppSwiftUI --> Cilicon.VMManager <<Relationship-UmVsYXRpb25zaGlw>> : "Starts the run cycle"
Cilicon.VMManager --> Cilicon.OCIClientLayerDownloaders <<Relationship-UmVsYXRpb25zaGlw>> : "Requests image pull when source is oci://"
Cilicon.OCIClientLayerDownloaders --> OCIRegistry <<Relationship-UmVsYXRpb25zaGlw>> : "Fetches manifest and blobs\n<size:16>[HTTPS]</size>"
Cilicon.OCIClientLayerDownloaders --> Cilicon.ImageCache <<Relationship-UmVsYXRpb25zaGlw>> : "Writes config.json, disk.img, nvram.bin"
Cilicon.VMManager --> Cilicon.ImageCache <<Relationship-UmVsYXRpb25zaGlw>> : "Copies master bundle"
Cilicon.VMManager --> Cilicon.VMClone <<Relationship-UmVsYXRpb25zaGlw>> : "Creates per-run clone, deletes on cleanup"
Cilicon.VMManager --> Cilicon.EphemeralmacOSGuestVM <<Relationship-UmVsYXRpb25zaGlw>> : "Boots from clone\n<size:16>[Virtualization.framework]</size>"
Cilicon.VMManager --> macOSHostServices <<Relationship-UmVsYXRpb25zaGlw>> : "Reads /var/db/dhcpd_leases for guest IP; sends restart Apple Event"
Cilicon.VMManager --> Cilicon.SSHClient <<Relationship-UmVsYXRpb25zaGlw>> : "Opens session, runs preRun/postRun and liveness probe"
Cilicon.SSHClient --> Cilicon.EphemeralmacOSGuestVM <<Relationship-UmVsYXRpb25zaGlw>> : "Executes shell commands\n<size:16>[SSH, password auth]</size>"
Cilicon.VMManager --> Cilicon.Provisioners <<Relationship-UmVsYXRpb25zaGlw>> : "Delegates provisioning"
Cilicon.Provisioners --> Cilicon.SSHClient <<Relationship-UmVsYXRpb25zaGlw>> : "Streams provisioning command"
Cilicon.Provisioners --> GitHubAPI <<Relationship-UmVsYXRpb25zaGlw>> : "JWT app auth, runner registration token, runner download URLs\n<size:16>[HTTPS REST]</size>"
Cilicon.EphemeralmacOSGuestVM --> GitHubAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Registers ephemeral runner and executes workflow job\n<size:16>[HTTPS]</size>"
Cilicon.EphemeralmacOSGuestVM --> GitLabInstance <<Relationship-UmVsYXRpb25zaGlw>> : "Runs single build via gitlab-runner\n<size:16>[HTTPS]</size>"
Cilicon.EphemeralmacOSGuestVM --> Buildkite <<Relationship-UmVsYXRpb25zaGlw>> : "Starts agent with --disconnect-after-job\n<size:16>[HTTPS]</size>"
Cilicon.EphemeralmacOSGuestVM --> RunnerBinaryDownloads <<Relationship-UmVsYXRpb25zaGlw>> : "Downloads runner/agent binaries\n<size:16>[HTTPS]</size>"

@enduml